<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM Suite" thread-count="1" verbose="1">
    <!-- Register the ExtentReport listener -->
    <listeners>
        <listener class-name="Utils.ExtentReportManager" />
    </listeners>
    
    <!-- Test Group for Chrome Browser -->
    <test name="OrangeHRM Automation Tests - Chrome">
        <classes>
            <class name="cucumberrunner.ChromeTestRunner" />
        </classes>
    </test>

    <!-- Test Group for Edge Browser (Disabled in offline environment)
    <test name="OrangeHRM Automation Tests - Edge">
        <classes>
            <class name="cucumberrunner.EdgeTestRunner" />
        </classes>
    </test>
    -->
</suite>
